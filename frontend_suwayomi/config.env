# ==============================================================================
# Configuración de Frontend Suwayomi (Niri Scratchpad)
# ==============================================================================
# Este archivo permite definir qué frontend de Suwayomi deseas utilizar
# como panel flotante con toggle dinámico en Niri.
#
# Puedes configurar mediante el preset FRONTEND o detallando APP_ID y LAUNCH_CMD.
# ==============================================================================

# Preset rápido: "tsumiru" o "kaori"
# Si se define FRONTEND, se autoconfiguran automáticamente APP_ID y LAUNCH_CMD.
FRONTEND="tsumiru"

# ------------------------------------------------------------------------------
# Configuración manual (opcional si usas FRONTEND o una app personalizada):
# ------------------------------------------------------------------------------
# APP_ID:
#   Identificador de la ventana en Wayland/Niri (lo que reporta 'niri msg -j windows').
#   - Para Tsumiru: "tsumiru"
#   - Para Kaori:   "io.github.riyaniii.Kaori"
#
# LAUNCH_CMD:
#   Comando exacto para iniciar la aplicación si no está en ejecución.
#   - Para Tsumiru: "flatpak run app.tsumiru.Tsumiru"
#   - Para Kaori:   "flatpak run io.github.riyaniii.Kaori"
#
# Si dejas LAUNCH_CMD vacío, el script intentará autodetectarlo inteligentemente.
# ------------------------------------------------------------------------------
# APP_ID="tsumiru"
# LAUNCH_CMD="flatpak run app.tsumiru.Tsumiru"

# Índice del workspace de fondo dinámico para ocultar la ventana (por defecto 99)
HIDE_WORKSPACE=99

# Mostrar notificaciones de escritorio en caso de error (true/false)
NOTIFY_ON_ERROR=true
